# AssemblyAI (EU-endpoint wordt automatisch gebruikt in lib/assemblyai.ts)
ASSEMBLYAI_API_KEY=

# Publiek bereikbare basis-URL van deze app, nodig zodat AssemblyAI de webhook kan
# aanroepen zodra een transcriptie klaar is (bv. https://vettext.vercel.app, of een
# ngrok-URL tijdens lokaal ontwikkelen — "localhost" werkt hier NIET).
APP_URL=

# Willekeurig, geheim wachtwoord dat wij aan AssemblyAI meegeven en terugverwachten
# in de webhook-call, zodat niemand anders nep-webhooks naar ons kan sturen.
ASSEMBLYAI_WEBHOOK_SECRET=

# Neon Postgres connection string
DATABASE_URL=

# Aantal dagen dat een gesprek bewaard blijft voordat de retentie-cron het verwijdert
RETENTIE_DAGEN=30

# Optioneel: beschermt /api/cron/retentie tegen aanroepen van buiten Vercel Cron
CRON_SECRET=
