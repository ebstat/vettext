# AssemblyAI (EU-endpoint wordt automatisch gebruikt in lib/assemblyai.ts)
ASSEMBLYAI_API_KEY=

# Publiek bereikbare basis-URL van deze app, nodig zodat AssemblyAI de webhook kan
# aanroepen zodra een transcriptie klaar is (bv. https://vettext.vercel.app, of een
# ngrok-URL tijdens lokaal ontwikkelen — "localhost" werkt hier NIET).
APP_URL=

# Willekeurig, geheim wachtwoord dat wij aan AssemblyAI meegeven en terugverwachten
# in de webhook-call, zodat niemand anders nep-webhooks naar ons kan sturen.
ASSEMBLYAI_WEBHOOK_SECRET=

# Vercel Blob — tijdelijke opslag van de opname tussen browser-upload en verwerking
# (omzeilt de 4,5MB-limiet op een Vercel Function request-body). Aanmaken via
# Vercel-dashboard > Storage > Create Database > Blob; wordt dan automatisch als
# env var in je Vercel-project gezet. Voor lokaal testen: kopieer 'm hierheen, of
# haal 'm op met `vercel env pull .env.local` zodra je bent ingelogd.
BLOB_READ_WRITE_TOKEN=

# OpenAI — voor de automatische samenvatting (lib/samenvatting.ts).
OPENAI_API_KEY=

# Optioneel: welk OpenAI-model voor de samenvatting gebruikt wordt. Standaard "gpt-5" als
# dit leeg is.
SAMENVATTING_MODEL=

# Neon Postgres connection string
DATABASE_URL=

# Aantal dagen dat een gesprek bewaard blijft voordat de retentie-cron het verwijdert
RETENTIE_DAGEN=30

# Optioneel: beschermt /api/cron/retentie tegen aanroepen van buiten Vercel Cron
CRON_SECRET=
